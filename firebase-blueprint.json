{
  "entities": {
    "User": {
      "title": "User Profile",
      "description": "Information about the registered user.",
      "type": "object",
      "properties": {
        "displayName": { "type": "string" },
        "email": { "type": "string" },
        "photoURL": { "type": "string" },
        "phoneNumber": { "type": "string" },
        "currentContestId": { "type": "string" },
        "termsAccepted": { "type": "boolean" },
        "privacyAccepted": { "type": "boolean" },
        "consentDate": { "type": "string", "format": "date-time" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["email", "createdAt"]
    },
    "Contest": {
      "title": "Contest",
      "description": "Study material and schedule for a specific contest.",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "role": { "type": "string" },
        "examDate": { "type": "string" },
        "dailyGoalHours": { "type": "number" },
        "dailyGoalQuestions": { "type": "number" },
        "ownerId": { "type": "string" },
        "ownerName": { "type": "string" },
        "likesCount": { "type": "number" },
        "isPublic": { "type": "boolean" },
        "subjects": {
          "type": "array",
          "items": { "type": "object" }
        },
        "schedule": {
          "type": "array",
          "items": { "type": "object" }
        },
        "dailyHistory": {
          "type": "array",
          "items": { "type": "object" }
        },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["name", "role", "ownerId"]
    },
    "ContestDetails": {
      "title": "Contest Details",
      "description": "Heavy data collections for a specific contest.",
      "type": "object",
      "properties": {
        "subjects": {
          "type": "array",
          "items": { "type": "object" }
        },
        "schedule": {
          "type": "array",
          "items": { "type": "object" }
        },
        "paretoData": {
          "type": "object"
        },
        "meppReviews": {
          "type": "array",
          "items": { "type": "object" }
        },
        "dailyHistory": {
          "type": "array",
          "items": { "type": "object" }
        }
      }
    },
    "Flashcard": {
      "title": "Flashcard",
      "description": "A study card with front and back content for spaced repetition.",
      "type": "object",
      "properties": {
        "front": { "type": "string" },
        "back": { "type": "string" },
        "subjectId": { "type": "string" },
        "subjectName": { "type": "string" },
        "ownerId": { "type": "string" },
        "ownerName": { "type": "string" },
        "isPublic": { "type": "boolean" },
        "nextReview": { "type": "string", "format": "date-time" },
        "interval": { "type": "number" },
        "ease": { "type": "number" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["front", "back", "ownerId"]
    },
    "FlashcardDeck": {
      "title": "Flashcard Deck",
      "description": "A collection of flashcards shared as a unit.",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "description": { "type": "string" },
        "ownerId": { "type": "string" },
        "ownerName": { "type": "string" },
        "cards": { "type": "array", "items": { "$ref": "Flashcard" } },
        "likesCount": { "type": "number" },
        "clonesCount": { "type": "number" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["title", "ownerId", "cards"]
    },
    "MindMap": {
      "title": "MindMap",
      "description": "A mind map with nodes and edges.",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "isPublic": { "type": "boolean" },
        "ownerId": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "nodes": { "type": "array", "items": { "type": "object" } },
        "edges": { "type": "array", "items": { "type": "object" } }
      },
      "required": ["title", "ownerId", "createdAt"]
    },
    "SupportTicket": {
      "title": "Support Ticket",
      "description": "A message sent by a user to support.",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "email": { "type": "string" },
        "subject": { "type": "string" },
        "message": { "type": "string" },
        "userId": { "type": "string" },
        "status": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["name", "email", "message", "createdAt"]
    },
    "StudySource": {
      "title": "Study Source",
      "description": "An interactive study document (text, file, youtube url, webpage) for document chat.",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "type": { "type": "string", "enum": ["text", "file", "youtube", "web"] },
        "content": { "type": "string" },
        "url": { "type": "string" },
        "fileName": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["title", "type", "content", "createdAt"]
    },
    "SourceMessage": {
      "title": "Source Message",
      "description": "A chat message inside a study source chat session.",
      "type": "object",
      "properties": {
        "role": { "type": "string", "enum": ["user", "model"] },
        "content": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["role", "content", "createdAt"]
    },
    "Audiocast": {
      "title": "Audiocast",
      "description": "An audio recording / podcast item uploaded by the admin for study purposes.",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "description": { "type": "string" },
        "duration": { "type": "string" },
        "category": { "type": "string" },
        "categoryLabel": { "type": "string" },
        "speaker": { "type": "string" },
        "audioUrl": { "type": "string" },
        "isPremium": { "type": "boolean" },
        "topics": {
          "type": "array",
          "items": { "type": "string" }
        },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["title", "audioUrl", "createdAt"]
    }
  },
  "firestore": {
    "/audiocasts/{audiocastId}": {
      "schema": "Audiocast",
      "description": "Stores audiocasts uploaded by the administrator."
    },
    "/users/{userId}": {
      "schema": "User",
      "description": "Stores user profile data."
    },
    "/users/{userId}/contests/{contestId}": {
      "schema": "Contest",
      "description": "Stores user-specific contest data and progress."
    },
    "/users/{userId}/contests/{contestId}/details/{detailId}": {
      "schema": "ContestDetails",
      "description": "Stores heavy collections of a contest (subjects, schedule, paretoData, etc.)."
    },
    "/users/{userId}/flashcards/{flashcardId}": {
      "schema": "Flashcard",
      "description": "Stores private user flashcards."
    },
    "/users/{userId}/sources/{sourceId}": {
      "schema": "StudySource",
      "description": "Stores user-specific customized study sources (web, YouTube, PDF, etc.)."
    },
    "/users/{userId}/sources/{sourceId}/messages/{messageId}": {
      "schema": "SourceMessage",
      "description": "Stores messages exchanged inside a study source context chat."
    },
    "/mindmaps/{mindmapId}": {
      "schema": "MindMap",
      "description": "Stores public and private mind maps."
    },
    "/shared_contests/{sharedId}": {
      "schema": "Contest",
      "description": "Stores public syllabi shared by users for the community."
    },
    "/shared_flashcards/{sharedId}": {
      "schema": "Flashcard",
      "description": "Stores public flashcards shared by users."
    },
    "/shared_decks/{deckId}": {
      "schema": "FlashcardDeck",
      "description": "Stores public flashcard decks shared by users as a unit."
    },
    "/support_tickets/{ticketId}": {
      "schema": "SupportTicket",
      "description": "Stores messages sent to support."
    }
  }
}
