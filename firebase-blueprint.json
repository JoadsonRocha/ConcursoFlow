{
  "entities": {
    "User": {
      "title": "User Profile",
      "description": "Information about the registered user.",
      "type": "object",
      "properties": {
        "displayName": { "type": "string" },
        "email": { "type": "string" },
        "photoURL": { "type": "string" },
        "currentContestId": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["email", "createdAt"]
    },
    "Contest": {
      "title": "Contest",
      "description": "Study material and schedule for a specific contest.",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "role": { "type": "string" },
        "examDate": { "type": "string" },
        "dailyGoalHours": { "type": "number" },
        "dailyGoalQuestions": { "type": "number" },
        "ownerId": { "type": "string" },
        "ownerName": { "type": "string" },
        "likesCount": { "type": "number" },
        "isPublic": { "type": "boolean" },
        "subjects": {
          "type": "array",
          "items": { "type": "object" }
        },
        "schedule": {
          "type": "array",
          "items": { "type": "object" }
        },
        "dailyHistory": {
          "type": "array",
          "items": { "type": "object" }
        },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["name", "role", "ownerId"]
    },
    "Flashcard": {
      "title": "Flashcard",
      "description": "A study card with front and back content for spaced repetition.",
      "type": "object",
      "properties": {
        "front": { "type": "string" },
        "back": { "type": "string" },
        "subjectId": { "type": "string" },
        "subjectName": { "type": "string" },
        "ownerId": { "type": "string" },
        "ownerName": { "type": "string" },
        "isPublic": { "type": "boolean" },
        "nextReview": { "type": "string", "format": "date-time" },
        "interval": { "type": "number" },
        "ease": { "type": "number" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["front", "back", "ownerId"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "Stores user profile data."
    },
    "/users/{userId}/contests/{contestId}": {
      "schema": "Contest",
      "description": "Stores user-specific contest data and progress."
    },
    "/users/{userId}/flashcards/{flashcardId}": {
      "schema": "Flashcard",
      "description": "Stores private user flashcards."
    },
    "/shared_contests/{sharedId}": {
      "schema": "Contest",
      "description": "Stores public syllabi shared by users for the community."
    },
    "/shared_flashcards/{sharedId}": {
      "schema": "Flashcard",
      "description": "Stores public flashcards shared by users."
    }
  }
}
