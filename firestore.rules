rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Pillar 2 & 3: Validation Blueprints with Hardened IDs
    function isVerified() {
      // Relaxed verification for better UX during development/testing
      // In production, you might want to enforce request.auth.token.email_verified == true
      return isSignedIn();
    }

    function isValidUser(data) {
      return data.keys().hasAll(['email', 'createdAt', 'updatedAt']) &&
             data.keys().size() >= 3 && data.keys().size() <= 12 &&
             data.email == request.auth.token.email &&
             isVerified() &&
             data.email is string && data.email.size() <= 256 &&
             data.createdAt is timestamp &&
             data.updatedAt is timestamp &&
             (data.get('displayName', null) == null || (data.displayName is string && data.displayName.size() <= 100)) &&
             (data.get('photoURL', null) == null || (data.photoURL is string && data.photoURL.size() <= 1000)) &&
             (data.get('currentContestId', null) == null || (data.currentContestId is string && data.currentContestId.size() <= 128));
    }

    function isValidContest(data) {
      return data.keys().hasAll(['name', 'role', 'ownerId', 'createdAt', 'updatedAt']) &&
             data.keys().size() >= 5 && data.keys().size() <= 18 &&
             data.ownerId == request.auth.uid &&
             data.name is string && data.name.size() <= 200 &&
             data.role is string && data.role.size() <= 200 &&
             data.createdAt is timestamp &&
             data.updatedAt is timestamp &&
             (data.get('ownerName', '') is string && data.get('ownerName', '').size() <= 100) &&
             (data.get('isPublic', false) is bool) &&
             (data.get('likesCount', 0) is number) &&
             (data.get('examDate', '') is string && data.get('examDate', '').size() <= 100) &&
             (data.get('dailyGoalHours', 0) is number || data.get('dailyGoalHours', 0) == '') &&
             (data.get('dailyGoalQuestions', 0) is number || data.get('dailyGoalQuestions', 0) == '') &&
             (data.get('subjects', []) is list) &&
             (data.get('schedule', []) is list) &&
             (data.get('id', '') is string);
    }

    // User Profile
    match /users/{userId} {
      allow get: if isSignedIn() && isOwner(userId);
      allow create: if isVerified() && isOwner(userId) && isValidUser(incoming()) && request.resource.data.createdAt == request.time;
      allow update: if isVerified() && isOwner(userId) && isValidUser(incoming()) && 
                    (incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'photoURL', 'currentContestId', 'updatedAt'])) &&
                    incoming().email == existing().email &&
                    incoming().createdAt == existing().createdAt &&
                    incoming().updatedAt == request.time;
      allow delete: if false;

      // Contests (Private)
      match /contests/{contestId} {
        allow read: if isSignedIn() && isOwner(userId);
        allow create: if isVerified() && isOwner(userId) && isValidContest(incoming()) && incoming().createdAt == request.time;
        allow update: if isVerified() && isOwner(userId) && isValidContest(incoming()) && 
                      (incoming().diff(existing()).affectedKeys().hasOnly(['name', 'role', 'examDate', 'dailyGoalHours', 'dailyGoalQuestions', 'subjects', 'schedule', 'updatedAt', 'isPublic', 'ownerName', 'id'])) &&
                      incoming().ownerId == existing().ownerId &&
                      incoming().createdAt == existing().createdAt &&
                      incoming().updatedAt == request.time;
        allow delete: if isVerified() && isOwner(userId);
      }
    }

    // Shared Contests (Community)
    match /shared_contests/{sharedId} {
      allow list: if isSignedIn(); // Any signed-in user can see the gallery
      allow get: if isSignedIn();
      allow create: if isVerified() && isValidContest(incoming()) && 
                    incoming().ownerId == request.auth.uid &&
                    incoming().isPublic == true &&
                    incoming().createdAt == request.time;
      allow update: if isVerified() && (
        // Action: Own Update
        (existing().ownerId == request.auth.uid && isValidContest(incoming()) &&
         incoming().diff(existing()).affectedKeys().hasOnly(['name', 'role', 'examDate', 'subjects', 'schedule', 'updatedAt', 'isPublic', 'ownerName', 'id'])) ||
        // Action: Like (Atomic Increment)
        (incoming().diff(existing()).affectedKeys().hasOnly(['likesCount']) && incoming().likesCount == existing().likesCount + 1)
      );
      allow delete: if isVerified() && existing().ownerId == request.auth.uid;
    }
  }
}
