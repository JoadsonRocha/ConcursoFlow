rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Pillar 2 & 3: Validation Blueprints with Hardened IDs
    function isValidUser(data) {
      return data.keys().hasAll(['email', 'createdAt', 'updatedAt']) &&
             data.email == request.auth.token.email &&
             data.email is string &&
             data.createdAt is timestamp &&
             data.updatedAt is timestamp &&
             (data.get('displayName', null) == null || data.displayName is string) &&
             (data.get('photoURL', null) == null || data.photoURL is string) &&
             (data.get('currentContestId', null) == null || data.currentContestId is string);
    }

    function isValidContest(data) {
      return data.keys().hasAll(['name', 'role', 'ownerId', 'createdAt', 'updatedAt']) &&
             data.ownerId == request.auth.uid &&
             data.name is string && data.name.size() <= 200 &&
             data.role is string && data.role.size() <= 200 &&
             data.createdAt is timestamp &&
             data.updatedAt is timestamp &&
             (data.get('examDate', '') is string) &&
             (data.get('dailyGoalHours', 0) is number || data.get('dailyGoalHours', 0) == '') &&
             (data.get('dailyGoalQuestions', 0) is number || data.get('dailyGoalQuestions', 0) == '') &&
             (data.get('subjects', []) is list) &&
             (data.get('schedule', []) is list);
    }

    // User Profile
    match /users/{userId} {
      allow get: if isSignedIn() && isOwner(userId);
      allow create: if isSignedIn() && isOwner(userId) && isValidUser(incoming()) && request.resource.data.createdAt == request.time;
      allow update: if isSignedIn() && isOwner(userId) && isValidUser(incoming()) && 
                    incoming().createdAt == existing().createdAt &&
                    request.resource.data.updatedAt == request.time;
      allow delete: if false;

      // Contests
      match /contests/{contestId} {
        allow read: if isSignedIn() && isOwner(userId);
        allow create: if isSignedIn() && isOwner(userId) && isValidContest(incoming()) && request.resource.data.createdAt == request.time;
        allow update: if isSignedIn() && isOwner(userId) && isValidContest(incoming()) && 
                      incoming().ownerId == existing().ownerId &&
                      incoming().createdAt == existing().createdAt &&
                      request.resource.data.updatedAt == request.time;
        allow delete: if isSignedIn() && isOwner(userId);
      }
    }
  }
}
