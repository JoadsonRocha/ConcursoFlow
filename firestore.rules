rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Pillar 2 & 3: Validation Blueprints with Hardened IDs
    function isVerified() {
      // Relaxed verification for better UX during development/testing
      // In production, you might want to enforce request.auth.token.email_verified == true
      return isSignedIn();
    }

    function isValidUser(data, isCreate) {
      return (!isCreate || (data.keys().hasAll(['email', 'createdAt', 'updatedAt']) && data.keys().size() >= 3)) &&
             (request.auth.token.email == null || data.get('email', 'not_provided') == request.auth.token.email) &&
             isVerified() &&
             (data.get('email', '') is string && data.get('email', '').size() <= 256) &&
             (data.get('createdAt', request.time) is timestamp) &&
             (data.get('updatedAt', request.time) is timestamp) &&
             (data.get('displayName', null) == null || (data.displayName is string && data.displayName.size() <= 100)) &&
             (data.get('photoURL', null) == null || (data.photoURL is string && data.photoURL.size() <= 1000)) &&
             (data.get('currentContestId', null) == null || (data.currentContestId is string && data.currentContestId.size() <= 128));
    }

    function isValidContest(data, isCreate) {
      return (!isCreate || (data.keys().hasAll(['name', 'role', 'ownerId', 'createdAt', 'updatedAt']) && data.keys().size() >= 5)) &&
             (data.get('ownerId', '') == request.auth.uid) &&
             (data.get('name', '') is string && data.get('name', '').size() <= 200) &&
             (data.get('role', '') is string && data.get('role', '').size() <= 200) &&
             (data.get('createdAt', request.time) is timestamp) &&
             (data.get('updatedAt', request.time) is timestamp) &&
             (data.get('ownerName', '') is string && data.get('ownerName', '').size() <= 100) &&
             (data.get('isPublic', false) is bool) &&
             (data.get('likesCount', 0) is number) &&
             (data.get('examDate', '') is string && data.get('examDate', '').size() <= 100) &&
             (data.get('dailyGoalHours', 0) is number || data.get('dailyGoalHours', 0) == '') &&
             (data.get('dailyGoalQuestions', 0) is number || data.get('dailyGoalQuestions', 0) == '') &&
             (data.get('subjects', []) is list) &&
             (data.get('schedule', []) is list) &&
             (data.get('dailyHistory', []) is list) &&
             (data.get('id', '') is string);
    }

    function isValidFlashcard(data, isCreate) {
      return (!isCreate || (data.keys().hasAll(['front', 'back', 'ownerId', 'createdAt', 'updatedAt']) && data.keys().size() >= 5)) &&
             (data.get('ownerId', '') == request.auth.uid) &&
             (data.get('front', '') is string && data.get('front', '').size() <= 1000) &&
             (data.get('back', '') is string && data.get('back', '').size() <= 3000) &&
             (data.get('createdAt', request.time) is timestamp) &&
             (data.get('updatedAt', request.time) is timestamp) &&
             (data.get('ownerName', '') is string && data.get('ownerName', '').size() <= 100) &&
             (data.get('isPublic', false) is bool) &&
             (data.get('subjectName', '') is string && data.get('subjectName', '').size() <= 100) &&
             (data.get('nextReview', request.time) is timestamp) &&
             (data.get('interval', 0) is number) &&
             (data.get('ease', 0) is number);
    }

    // User Profile
    match /users/{userId} {
      allow get: if isSignedIn() && isOwner(userId);
      allow create: if isVerified() && isOwner(userId) && isValidUser(incoming(), true) && request.resource.data.createdAt == request.time;
      allow update: if isVerified() && isOwner(userId) && isValidUser(incoming(), false) && 
                    (incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'photoURL', 'currentContestId', 'updatedAt'])) &&
                    incoming().email == existing().email &&
                    (existing().get('createdAt', null) == null || incoming().createdAt == existing().createdAt) &&
                    incoming().updatedAt == request.time;
      allow delete: if false;

      // Contests (Private)
      match /contests/{allContestIds=**} {
        allow read, write: if isSignedIn() && isOwner(userId);
      }

      // Flashcards (Private)
      match /flashcards/{flashcardId} {
        allow list, get: if isSignedIn() && isOwner(userId);
        allow create: if isVerified() && isOwner(userId) && isValidFlashcard(incoming(), true) && incoming().createdAt == request.time;
        allow update: if isVerified() && isOwner(userId) && isValidFlashcard(incoming(), false) && 
                      (incoming().diff(existing()).affectedKeys().hasOnly(['front', 'back', 'isPublic', 'nextReview', 'interval', 'ease', 'updatedAt', 'subjectName'])) &&
                      incoming().ownerId == existing().ownerId &&
                      (existing().get('createdAt', null) == null || incoming().createdAt == existing().createdAt) &&
                      incoming().updatedAt == request.time;
        allow delete: if isVerified() && isOwner(userId);
      }
    }

    // Shared Contests (Community)
    match /shared_contests/{sharedId} {
      allow list: if isSignedIn() && (resource.data.isPublic == true || resource.data.ownerId == request.auth.uid);
      allow get: if isSignedIn() && (resource.data.isPublic == true || resource.data.ownerId == request.auth.uid);
      allow create: if isVerified() && isValidContest(incoming(), true) && 
                    incoming().ownerId == request.auth.uid &&
                    incoming().isPublic == true &&
                    incoming().createdAt == request.time;
      allow update: if isVerified() && (
        // Action: Own Update
        (existing().ownerId == request.auth.uid && isValidContest(incoming(), false) &&
         incoming().diff(existing()).affectedKeys().hasOnly(['name', 'role', 'examDate', 'dailyGoalHours', 'dailyGoalQuestions', 'subjects', 'schedule', 'dailyHistory', 'updatedAt', 'isPublic', 'ownerName', 'id', 'ownerId', 'createdAt', 'likesCount'])) ||
        // Action: Like (Atomic Increment)
        (incoming().diff(existing()).affectedKeys().hasOnly(['likesCount']) && incoming().likesCount == existing().likesCount + 1)
      );
      allow delete: if isVerified() && existing().ownerId == request.auth.uid;
    }

    // Shared Flashcards (Community)
    match /shared_flashcards/{sharedId} {
      allow list: if isSignedIn() && (resource.data.isPublic == true || resource.data.ownerId == request.auth.uid);
      allow get: if isSignedIn() && (resource.data.isPublic == true || resource.data.ownerId == request.auth.uid);
      allow create: if isVerified() && isValidFlashcard(incoming(), true) && 
                    incoming().ownerId == request.auth.uid &&
                    incoming().isPublic == true &&
                    incoming().createdAt == request.time;
      allow update: if isVerified() && existing().ownerId == request.auth.uid && 
                    isValidFlashcard(incoming(), false) &&
                    incoming().diff(existing()).affectedKeys().hasOnly(['front', 'back', 'isPublic', 'nextReview', 'interval', 'ease', 'updatedAt', 'subjectName']);
      allow delete: if isVerified() && existing().ownerId == request.auth.uid;
    }
  }
}
