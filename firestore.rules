rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() { return request.auth != null; }
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }
    function isOwner(uid) { return isSignedIn() && request.auth.uid == uid; }
    function isValidMindMap(data) {
      return data.title is string && data.title.size() <= 100 &&
             data.isPublic is bool &&
             data.ownerId is string &&
             data.createdAt is timestamp;
    }

    match /feedbacks/{feedbackId} {
      allow read: if false; // only admin can read
      allow create: if isSignedIn() && incoming().userId == request.auth.uid;
      allow update, delete: if false;
    }

    match /users/{userId} {
      allow read: if isOwner(userId);
      allow create: if isOwner(userId) && incoming().email == request.auth.token.email;
      allow update: if isOwner(userId);
      allow delete: if isOwner(userId);
      
      match /contests/{contestId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId) && incoming().ownerId == userId;
        allow update: if isOwner(userId);
        allow delete: if isOwner(userId);
      }
      
      match /flashcards/{flashcardId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId) && incoming().ownerId == userId;
        allow update: if isOwner(userId);
        allow delete: if isOwner(userId);
      }
    }

    match /shared_contests/{sharedId} {
      allow read: if true;
      allow create: if isSignedIn() && incoming().ownerId == request.auth.uid;
      allow update: if isSignedIn() && (
        (incoming().diff(existing()).affectedKeys().hasOnly(['likesCount'])) ||
        (existing().ownerId == request.auth.uid)
      );
      allow delete: if isSignedIn() && existing().ownerId == request.auth.uid;
    }
    
    match /shared_flashcards/{sharedId} {
      allow read: if true;
      allow create: if isSignedIn() && incoming().ownerId == request.auth.uid;
      allow update: if isSignedIn() && (
        (incoming().diff(existing()).affectedKeys().hasOnly(['likesCount'])) ||
        (existing().ownerId == request.auth.uid)
      );
      allow delete: if isSignedIn() && existing().ownerId == request.auth.uid;
    }

    match /mindmaps/{mindmapId} {
      allow read: if (resource.data.isPublic == true) || (isSignedIn() && resource.data.ownerId == request.auth.uid);
      allow create: if isSignedIn() && incoming().ownerId == request.auth.uid;
      allow update: if isSignedIn() && (
        (resource.data.isPublic == true && incoming().diff(existing()).affectedKeys().hasOnly(['likesCount', 'clonesCount'])) ||
        (existing().ownerId == request.auth.uid)
      );
      allow delete: if isSignedIn() && existing().ownerId == request.auth.uid;
    }
  }
}
