rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Default fallback - allow nothing
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Helpers ---
    function isSignedIn() { return request.auth != null; }
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }
    function isOwner(uid) { return isSignedIn() && request.auth.uid == uid; }

    // --- Collections ---

    // Feedbacks
    match /feedbacks/{feedbackId} {
      allow read: if false; // only admin can read
      allow create: if isSignedIn() && incoming().userId == request.auth.uid;
      allow update, delete: if false;
    }

    // Support Tickets
    match /support_tickets/{ticketId} {
      allow create: if incoming().userId == null || (isSignedIn() && incoming().userId == request.auth.uid);
      allow read: if isSignedIn() && (
        resource.data.userId == request.auth.uid || 
        (request.auth.token.email_verified == true && (
          request.auth.token.email.matches('(?i)onrocha08@gmail\\.com') || 
          request.auth.token.email.matches('(?i)joadsonrocharr@gmail\\.com')
        ))
      );
      allow update, delete: if isSignedIn() && request.auth.token.email_verified == true && (
        request.auth.token.email.matches('(?i)onrocha08@gmail\\.com') || 
        request.auth.token.email.matches('(?i)joadsonrocharr@gmail\\.com')
      );
    }

    // User Data
    match /users/{userId} {
      allow read: if isOwner(userId);
      allow create: if isOwner(userId);
      allow update: if isOwner(userId);
      allow delete: if isOwner(userId);
      
      // Legacy/Existing Subcollections
      match /contests/{contestId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId) && incoming().ownerId == userId;
        allow update: if isOwner(userId);
        allow delete: if isOwner(userId);
      }
      
      match /flashcards/{flashcardId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId) && incoming().ownerId == userId;
        allow update: if isOwner(userId);
        allow delete: if isOwner(userId);
      }

      // --- NEW: Study Sources and Chat ---
      match /sources/{sourceId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId);
        allow update: if isOwner(userId);
        allow delete: if isOwner(userId);

        match /messages/{messageId} {
          allow read: if isOwner(userId);
          allow create: if isOwner(userId);
          allow update: if isOwner(userId);
          allow delete: if isOwner(userId);
        }
      }
    }

    // Shared / Community Content
    match /shared_contests/{sharedId} {
      allow read: if true;
      allow create: if isSignedIn() && incoming().ownerId == request.auth.uid;
      allow update: if isSignedIn() && (
        (incoming().diff(existing()).affectedKeys().hasOnly(['likesCount'])) ||
        (existing().ownerId == request.auth.uid)
      );
      allow delete: if isSignedIn() && existing().ownerId == request.auth.uid;
    }
    
    match /shared_flashcards/{sharedId} {
      allow read: if true;
      allow create: if isSignedIn() && incoming().ownerId == request.auth.uid;
      allow update: if isSignedIn() && (
        (incoming().diff(existing()).affectedKeys().hasOnly(['likesCount'])) ||
        (existing().ownerId == request.auth.uid)
      );
      allow delete: if isSignedIn() && existing().ownerId == request.auth.uid;
    }

    match /shared_decks/{deckId} {
      allow read: if true;
      allow create: if isSignedIn() && incoming().ownerId == request.auth.uid;
      allow update: if isSignedIn() && (
        (incoming().diff(existing()).affectedKeys().hasOnly(['likesCount', 'clonesCount'])) ||
        (existing().ownerId == request.auth.uid)
      );
      allow delete: if isSignedIn() && existing().ownerId == request.auth.uid;
    }

    // MindMaps
    match /mindmaps/{mindmapId} {
      allow read: if (resource.data.isPublic == true) || (isSignedIn() && resource.data.ownerId == request.auth.uid);
      allow create: if isSignedIn() && incoming().ownerId == request.auth.uid;
      allow update: if isSignedIn() && (
        (resource.data.isPublic == true && incoming().diff(existing()).affectedKeys().hasOnly(['likesCount', 'clonesCount'])) ||
        (existing().ownerId == request.auth.uid)
      ) || (isOwner(resource.data.ownerId));
      allow delete: if isSignedIn() && existing().ownerId == request.auth.uid;
    }

    // Audiocasts
    match /audiocasts/{audiocastId} {
      allow read: if true;
      allow write: if isSignedIn() && request.auth.token.email_verified == true && (
        request.auth.token.email.matches('(?i)onrocha08@gmail\\.com') || 
        request.auth.token.email.matches('(?i)joadsonrocharr@gmail\\.com')
      );
    }
  }
}
