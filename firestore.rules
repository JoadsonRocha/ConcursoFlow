rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
      match /{document=**} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }

    match /mindmaps/{document=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /shared_contests/{document=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /shared_decks/{document=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /shared_flashcards/{document=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /support_tickets/{document=**} {
      allow create: if true;
      allow read, write: if request.auth != null;
    }

    match /feedbacks/{document=**} {
      allow create: if true;
      allow read, write: if request.auth != null;
    }

    match /mail/{document=**} {
      allow read, write: if request.auth != null;
    }

    // Default fallback - allow nothing
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
